# The war room talks to the private services through its own server-side proxy,
# so the browser never holds a credential and never sees a service URL.
URL_ORCHESTRATOR=http://localhost:8080
URL_LEDGER=http://localhost:8082
URL_RENDERER=http://localhost:8084

# Public demo mode: let a visitor choose which role they are acting as, so a judge
# can walk the counsel gate. Never enable this on a project with real material.
NEXT_PUBLIC_DEMO_IDENTITY=true
DEMO_SUBJECT_PRODUCER=producer@clearframe.dev
DEMO_SUBJECT_COORDINATOR=coord@clearframe.dev
DEMO_SUBJECT_COUNSEL=counsel@clearframe.dev
DEMO_SUBJECT_REVIEWER=reviewer@clearframe.dev
