{
  "openapi": "3.1.0",
  "info": {
    "title": "ClearFrame Parallel adapter",
    "description": "One seam for every Parallel API call: Task, Deep Research, FindAll, Monitor. Search and Extract also reach agents through Parallel's managed MCP server.",
    "version": "0.1.0"
  },
  "paths": {
    "/task/run": {
      "post": {
        "summary": "Run one structured research task and return a normalized finding",
        "description": "T1-T3. The processor comes from the tier; the caller never picks it directly.",
        "operationId": "task_run_task_run_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TaskRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FindingResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/search": {
      "post": {
        "summary": "T0 recon \u2014 cited excerpts",
        "operationId": "do_search_search_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SearchRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SearchResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/extract": {
      "post": {
        "summary": "Fetch cited pages as clean markdown",
        "operationId": "do_extract_extract_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ExtractRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Do Extract Extract Post"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/findall": {
      "post": {
        "summary": "Discover controlling entities and licensing contacts",
        "operationId": "do_findall_findall_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/FindAllRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Do Findall Findall Post"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/monitor/arm": {
      "post": {
        "summary": "Arm a Parallel Monitor on a rights holder",
        "operationId": "arm_monitor_arm_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ArmWatchRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Arm Monitor Arm Post"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/monitor/{monitor_id}": {
      "delete": {
        "summary": "Disarm a watch",
        "operationId": "disarm_monitor__monitor_id__delete",
        "parameters": [
          {
            "name": "monitor_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Monitor Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true,
                  "title": "Response Disarm Monitor  Monitor Id  Delete"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/monitor/{monitor_id}/events": {
      "get": {
        "summary": "Poll a watch's events",
        "operationId": "monitor_events_monitor__monitor_id__events_get",
        "parameters": [
          {
            "name": "monitor_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Monitor Id"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 20,
              "title": "Limit"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true,
                  "title": "Response Monitor Events Monitor  Monitor Id  Events Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/healthz": {
      "get": {
        "summary": "Liveness, and whether the API key is readable",
        "operationId": "healthz_healthz_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Healthz Healthz Get"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ArmWatchRequest": {
        "properties": {
          "subject": {
            "type": "string",
            "title": "Subject"
          },
          "change_classes": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Change Classes"
          },
          "webhook_url": {
            "type": "string",
            "title": "Webhook Url"
          },
          "frequency": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Frequency"
          },
          "metadata": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object",
            "title": "Metadata"
          }
        },
        "type": "object",
        "required": [
          "subject",
          "change_classes",
          "webhook_url"
        ],
        "title": "ArmWatchRequest"
      },
      "Authority": {
        "type": "string",
        "enum": [
          "registry",
          "court",
          "corporate",
          "trade",
          "reference",
          "other"
        ],
        "title": "Authority"
      },
      "Citation": {
        "properties": {
          "citation_id": {
            "type": "string",
            "title": "Citation Id"
          },
          "url": {
            "type": "string",
            "title": "Url"
          },
          "title": {
            "type": "string",
            "title": "Title",
            "default": ""
          },
          "excerpt": {
            "type": "string",
            "title": "Excerpt",
            "default": ""
          },
          "fetched_ts": {
            "type": "string",
            "format": "date-time",
            "title": "Fetched Ts"
          },
          "published_date": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Published Date"
          },
          "snapshot_uri": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Snapshot Uri"
          },
          "authority": {
            "$ref": "#/components/schemas/Authority",
            "default": "other"
          },
          "field": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Field"
          }
        },
        "type": "object",
        "required": [
          "citation_id",
          "url"
        ],
        "title": "Citation"
      },
      "ExtractRequest": {
        "properties": {
          "urls": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Urls"
          },
          "objective": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Objective"
          },
          "full_content": {
            "type": "boolean",
            "title": "Full Content",
            "default": false
          }
        },
        "type": "object",
        "required": [
          "urls"
        ],
        "title": "ExtractRequest"
      },
      "FindAllRequest": {
        "properties": {
          "objective": {
            "type": "string",
            "title": "Objective"
          },
          "match_conditions": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "type": "array",
            "title": "Match Conditions"
          },
          "entity_type": {
            "type": "string",
            "title": "Entity Type",
            "default": "companies"
          },
          "generator": {
            "type": "string",
            "title": "Generator",
            "default": "core"
          },
          "match_limit": {
            "type": "integer",
            "title": "Match Limit",
            "default": 10
          }
        },
        "type": "object",
        "required": [
          "objective",
          "match_conditions"
        ],
        "title": "FindAllRequest"
      },
      "Finding": {
        "properties": {
          "finding_id": {
            "type": "string",
            "title": "Finding Id"
          },
          "item_id": {
            "type": "string",
            "title": "Item Id"
          },
          "project_id": {
            "type": "string",
            "title": "Project Id"
          },
          "pass_id": {
            "type": "string",
            "title": "Pass Id"
          },
          "agent": {
            "type": "string",
            "title": "Agent"
          },
          "claim": {
            "additionalProperties": true,
            "type": "object",
            "title": "Claim"
          },
          "confidence": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Confidence",
            "default": 0.5
          },
          "citations": {
            "items": {
              "$ref": "#/components/schemas/Citation"
            },
            "type": "array",
            "title": "Citations"
          },
          "interaction_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Interaction Id"
          },
          "prev_interaction_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Prev Interaction Id"
          },
          "superseded_by": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Superseded By"
          },
          "tier": {
            "type": "integer",
            "title": "Tier",
            "default": 1
          },
          "cost_usd": {
            "type": "number",
            "title": "Cost Usd",
            "default": 0.0
          },
          "ts": {
            "type": "string",
            "format": "date-time",
            "title": "Ts"
          }
        },
        "type": "object",
        "required": [
          "finding_id",
          "item_id",
          "project_id",
          "pass_id",
          "agent",
          "claim"
        ],
        "title": "Finding"
      },
      "FindingResponse": {
        "properties": {
          "finding": {
            "$ref": "#/components/schemas/Finding"
          },
          "cost_usd": {
            "type": "number",
            "title": "Cost Usd"
          },
          "processor": {
            "type": "string",
            "title": "Processor"
          },
          "run_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Run Id"
          },
          "interaction_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Interaction Id"
          }
        },
        "type": "object",
        "required": [
          "finding",
          "cost_usd",
          "processor"
        ],
        "title": "FindingResponse"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "SearchRequest": {
        "properties": {
          "objective": {
            "type": "string",
            "title": "Objective"
          },
          "search_queries": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Search Queries"
          },
          "max_results": {
            "type": "integer",
            "title": "Max Results",
            "default": 8
          },
          "as_citations": {
            "type": "boolean",
            "title": "As Citations",
            "default": false
          }
        },
        "type": "object",
        "required": [
          "objective",
          "search_queries"
        ],
        "title": "SearchRequest"
      },
      "SearchResponse": {
        "properties": {
          "search_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Search Id"
          },
          "results": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "type": "array",
            "title": "Results"
          },
          "citations": {
            "items": {
              "$ref": "#/components/schemas/Citation"
            },
            "type": "array",
            "title": "Citations"
          },
          "cost_usd": {
            "type": "number",
            "title": "Cost Usd",
            "default": 0.003
          }
        },
        "type": "object",
        "title": "SearchResponse"
      },
      "TaskRequest": {
        "properties": {
          "objective": {
            "type": "string",
            "title": "Objective"
          },
          "schema_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Schema Name",
            "description": "music_rights | trademark | likeness | footage"
          },
          "output_schema": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Output Schema"
          },
          "tier": {
            "type": "integer",
            "title": "Tier",
            "default": 1
          },
          "item_id": {
            "type": "string",
            "title": "Item Id"
          },
          "project_id": {
            "type": "string",
            "title": "Project Id"
          },
          "pass_id": {
            "type": "string",
            "title": "Pass Id"
          },
          "agent": {
            "type": "string",
            "title": "Agent"
          },
          "prev_interaction_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Prev Interaction Id"
          },
          "snapshot": {
            "type": "boolean",
            "title": "Snapshot",
            "default": true
          }
        },
        "type": "object",
        "required": [
          "objective",
          "item_id",
          "project_id",
          "pass_id",
          "agent"
        ],
        "title": "TaskRequest"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
