{
  "openapi": "3.1.0",
  "info": {
    "title": "ClearFrame ledger API",
    "description": "Append-only, hash-chained. No update path exists, by design.",
    "version": "0.1.0"
  },
  "paths": {
    "/findings": {
      "post": {
        "summary": "submit_finding \u2014 the crews' only write path",
        "operationId": "submit_finding_findings_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Finding"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Submit Finding Findings Post"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/assessments": {
      "post": {
        "summary": "Record a risk assessment",
        "operationId": "submit_assessment_assessments_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RiskAssessment"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Submit Assessment Assessments Post"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/events": {
      "post": {
        "summary": "Append one event to the chain",
        "operationId": "append_event_events_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LedgerEvent"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Append Event Events Post"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/events/{project_id}": {
      "get": {
        "summary": "Read the chain in order",
        "operationId": "list_events_events__project_id__get",
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Project Id"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 500,
              "title": "Limit"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true,
                  "title": "Response List Events Events  Project Id  Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/verify/{project_id}": {
      "get": {
        "summary": "Recompute the hash chain",
        "operationId": "verify_verify__project_id__get",
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Project Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true,
                  "title": "Response Verify Verify  Project Id  Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/projects/{project_id}/decisions": {
      "post": {
        "summary": "Record a human decision",
        "operationId": "make_decision_projects__project_id__decisions_post",
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Project Id"
            }
          },
          {
            "name": "x-goog-iap-jwt-assertion",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Goog-Iap-Jwt-Assertion"
            }
          },
          {
            "name": "authorization",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          },
          {
            "name": "x-clearframe-subject",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Clearframe-Subject"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DecisionRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true,
                  "title": "Response Make Decision Projects  Project Id  Decisions Post"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/projects/{project_id}/roles": {
      "put": {
        "summary": "Bind a principal to a project role",
        "description": "Mirrors the Cloud IAM binding into the state plane so the API can enforce it\non every request without a directory round-trip.",
        "operationId": "put_role_projects__project_id__roles_put",
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Project Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RoleBinding"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true,
                  "title": "Response Put Role Projects  Project Id  Roles Put"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/projects/{project_id}/holders": {
      "get": {
        "summary": "The rights-holder graph",
        "operationId": "list_holders_projects__project_id__holders_get",
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Project Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true,
                  "title": "Response List Holders Projects  Project Id  Holders Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/holders": {
      "post": {
        "summary": "Upsert a rights holder (FindAll enrichment lands here)",
        "operationId": "upsert_holder_holders_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RightsHolder"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Upsert Holder Holders Post"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/healthz": {
      "get": {
        "summary": "Healthz",
        "operationId": "healthz_healthz_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Healthz Healthz Get"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Authority": {
        "type": "string",
        "enum": [
          "registry",
          "court",
          "corporate",
          "trade",
          "reference",
          "other"
        ],
        "title": "Authority"
      },
      "Citation": {
        "properties": {
          "citation_id": {
            "type": "string",
            "title": "Citation Id"
          },
          "url": {
            "type": "string",
            "title": "Url"
          },
          "title": {
            "type": "string",
            "title": "Title",
            "default": ""
          },
          "excerpt": {
            "type": "string",
            "title": "Excerpt",
            "default": ""
          },
          "fetched_ts": {
            "type": "string",
            "format": "date-time",
            "title": "Fetched Ts"
          },
          "published_date": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Published Date"
          },
          "snapshot_uri": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Snapshot Uri"
          },
          "authority": {
            "$ref": "#/components/schemas/Authority",
            "default": "other"
          },
          "field": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Field"
          }
        },
        "type": "object",
        "required": [
          "citation_id",
          "url"
        ],
        "title": "Citation"
      },
      "Contact": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name",
            "default": ""
          },
          "role": {
            "type": "string",
            "title": "Role",
            "default": ""
          },
          "email": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Email"
          },
          "phone": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Phone"
          },
          "url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Url"
          },
          "source_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Source Url"
          }
        },
        "type": "object",
        "title": "Contact"
      },
      "DecisionAction": {
        "type": "string",
        "enum": [
          "approve_mitigation",
          "reject_mitigation",
          "approve_outreach",
          "reject_outreach",
          "request_reinvestigation",
          "sign_report",
          "raise_budget",
          "flag_for_watch"
        ],
        "title": "DecisionAction"
      },
      "DecisionRequest": {
        "properties": {
          "action": {
            "$ref": "#/components/schemas/DecisionAction"
          },
          "rationale": {
            "type": "string",
            "minLength": 1,
            "title": "Rationale"
          },
          "item_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Item Id"
          },
          "target_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Target Id"
          }
        },
        "type": "object",
        "required": [
          "action",
          "rationale"
        ],
        "title": "DecisionRequest"
      },
      "Finding": {
        "properties": {
          "finding_id": {
            "type": "string",
            "title": "Finding Id"
          },
          "item_id": {
            "type": "string",
            "title": "Item Id"
          },
          "project_id": {
            "type": "string",
            "title": "Project Id"
          },
          "pass_id": {
            "type": "string",
            "title": "Pass Id"
          },
          "agent": {
            "type": "string",
            "title": "Agent"
          },
          "claim": {
            "additionalProperties": true,
            "type": "object",
            "title": "Claim"
          },
          "confidence": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Confidence",
            "default": 0.5
          },
          "citations": {
            "items": {
              "$ref": "#/components/schemas/Citation"
            },
            "type": "array",
            "title": "Citations"
          },
          "interaction_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Interaction Id"
          },
          "prev_interaction_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Prev Interaction Id"
          },
          "superseded_by": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Superseded By"
          },
          "tier": {
            "type": "integer",
            "title": "Tier",
            "default": 1
          },
          "cost_usd": {
            "type": "number",
            "title": "Cost Usd",
            "default": 0.0
          },
          "ts": {
            "type": "string",
            "format": "date-time",
            "title": "Ts"
          }
        },
        "type": "object",
        "required": [
          "finding_id",
          "item_id",
          "project_id",
          "pass_id",
          "agent",
          "claim"
        ],
        "title": "Finding"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HolderKind": {
        "type": "string",
        "enum": [
          "publisher",
          "label",
          "estate",
          "trademark_owner",
          "archive",
          "artist",
          "individual",
          "unknown"
        ],
        "title": "HolderKind"
      },
      "LedgerEvent": {
        "properties": {
          "project_id": {
            "type": "string",
            "title": "Project Id"
          },
          "actor": {
            "type": "string",
            "title": "Actor"
          },
          "event": {
            "additionalProperties": true,
            "type": "object",
            "title": "Event"
          }
        },
        "type": "object",
        "required": [
          "project_id",
          "actor",
          "event"
        ],
        "title": "LedgerEvent"
      },
      "Mitigation": {
        "properties": {
          "mitigation_id": {
            "type": "string",
            "title": "Mitigation Id"
          },
          "kind": {
            "$ref": "#/components/schemas/MitigationKind"
          },
          "summary": {
            "type": "string",
            "title": "Summary"
          },
          "cost_delta_usd": {
            "type": "number",
            "title": "Cost Delta Usd",
            "default": 0.0
          },
          "production_impact": {
            "type": "string",
            "title": "Production Impact",
            "default": ""
          },
          "recommended": {
            "type": "boolean",
            "title": "Recommended",
            "default": false
          }
        },
        "type": "object",
        "required": [
          "mitigation_id",
          "kind",
          "summary"
        ],
        "title": "Mitigation"
      },
      "MitigationKind": {
        "type": "string",
        "enum": [
          "license",
          "replace",
          "alter",
          "remove",
          "fair_use_memo",
          "no_action"
        ],
        "title": "MitigationKind"
      },
      "RightsHolder": {
        "properties": {
          "holder_id": {
            "type": "string",
            "title": "Holder Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "kind": {
            "$ref": "#/components/schemas/HolderKind",
            "default": "unknown"
          },
          "parent_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Parent Id"
          },
          "aliases": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Aliases"
          },
          "contacts": {
            "items": {
              "$ref": "#/components/schemas/Contact"
            },
            "type": "array",
            "title": "Contacts"
          },
          "watch_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Watch Id"
          },
          "source_urls": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Source Urls"
          },
          "first_seen": {
            "type": "string",
            "format": "date-time",
            "title": "First Seen"
          },
          "last_verified": {
            "type": "string",
            "format": "date-time",
            "title": "Last Verified"
          }
        },
        "type": "object",
        "required": [
          "holder_id",
          "name"
        ],
        "title": "RightsHolder"
      },
      "RiskAssessment": {
        "properties": {
          "assessment_id": {
            "type": "string",
            "title": "Assessment Id"
          },
          "item_id": {
            "type": "string",
            "title": "Item Id"
          },
          "project_id": {
            "type": "string",
            "title": "Project Id"
          },
          "pass_id": {
            "type": "string",
            "title": "Pass Id"
          },
          "risk_state": {
            "$ref": "#/components/schemas/RiskState"
          },
          "rationale": {
            "type": "string",
            "title": "Rationale"
          },
          "grounding_refs": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Grounding Refs"
          },
          "citations": {
            "items": {
              "$ref": "#/components/schemas/Citation"
            },
            "type": "array",
            "title": "Citations"
          },
          "mitigations": {
            "items": {
              "$ref": "#/components/schemas/Mitigation"
            },
            "type": "array",
            "title": "Mitigations"
          },
          "requires_approval": {
            "type": "boolean",
            "title": "Requires Approval",
            "default": false
          },
          "disclaimer": {
            "type": "string",
            "title": "Disclaimer",
            "default": "Research and drafting for review by production counsel. Not legal advice."
          },
          "agent": {
            "type": "string",
            "title": "Agent",
            "default": "risk_counsel"
          },
          "ts": {
            "type": "string",
            "format": "date-time",
            "title": "Ts"
          }
        },
        "type": "object",
        "required": [
          "assessment_id",
          "item_id",
          "project_id",
          "pass_id",
          "risk_state",
          "rationale"
        ],
        "title": "RiskAssessment"
      },
      "RiskState": {
        "type": "string",
        "enum": [
          "green",
          "amber",
          "red",
          "unknown"
        ],
        "title": "RiskState"
      },
      "Role": {
        "type": "string",
        "enum": [
          "producer",
          "coordinator",
          "counsel",
          "reviewer"
        ],
        "title": "Role"
      },
      "RoleBinding": {
        "properties": {
          "subject": {
            "type": "string",
            "title": "Subject"
          },
          "role": {
            "$ref": "#/components/schemas/Role"
          }
        },
        "type": "object",
        "required": [
          "subject",
          "role"
        ],
        "title": "RoleBinding"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
