{
  "compilerOptions": {
    "target": "ES2022", "module": "ES2022", "moduleResolution": "bundler",
    "lib": ["ES2023"], "outDir": "dist", "rootDir": "src",
    "strict": true, "declaration": true, "declarationMap": true,
    "esModuleInterop": true, "skipLibCheck": true
  },
  "include": ["src/**/*.ts"]
}
