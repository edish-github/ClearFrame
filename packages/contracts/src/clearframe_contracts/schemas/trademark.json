{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "mark":                { "type": "string", "description": "The mark as it appears in the frame" },
    "owner_of_record":     { "type": "string", "description": "Current registrant or assignee of record" },
    "registration_status": { "type": "string", "description": "live | dead | pending | unregistered | unknown" },
    "registration_numbers":{ "type": "array", "items": { "type": "string" } },
    "jurisdictions":       { "type": "array", "items": { "type": "string" } },
    "classes":             { "type": "array", "items": { "type": "string" }, "description": "Nice classes covered" },
    "assignments":         {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": { "from": {"type":"string"}, "to": {"type":"string"}, "year": {"type":"integer"}, "source_url": {"type":"string"} },
        "required": ["to", "source_url"]
      }
    },
    "enforcement_temperament": { "type": "string", "description": "litigious | active | passive | unknown — grounded in observed enforcement history, not inference" },
    "enforcement_examples":{
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": { "summary": {"type":"string"}, "year": {"type":"integer"}, "source_url": {"type":"string"} },
        "required": ["summary", "source_url"]
      }
    },
    "depiction_objections": { "type": "boolean", "description": "Has this owner objected to depiction in film or television specifically" },
    "litigation_signals":  {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": { "summary": {"type":"string"}, "status": {"type":"string"}, "source_url": {"type":"string"} },
        "required": ["summary", "source_url"]
      }
    },
    "conflicting_sources": { "type": "boolean" },
    "unresolved_questions":{ "type": "array", "items": { "type": "string" } },
    "confidence":          { "type": "number" }
  },
  "required": ["owner_of_record", "registration_status", "confidence"]
}
