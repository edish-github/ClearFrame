{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "person_name":         { "type": "string" },
    "living":              { "type": "string", "description": "living | deceased | unknown" },
    "date_of_death":       { "type": "string" },
    "domicile_jurisdiction": { "type": "string", "description": "Jurisdiction governing publicity rights, where establishable" },
    "postmortem_rights":   { "type": "string", "description": "Whether the jurisdiction recognises post-mortem publicity rights and for how long" },
    "rights_representative": { "type": "string", "description": "Estate, agency, or representative controlling likeness rights" },
    "prior_objections":    {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": { "summary": {"type":"string"}, "year": {"type":"integer"}, "source_url": {"type":"string"} },
        "required": ["summary", "source_url"]
      }
    },
    "litigation_signals":  {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": { "summary": {"type":"string"}, "status": {"type":"string"}, "source_url": {"type":"string"} },
        "required": ["summary", "source_url"]
      }
    },
    "defamation_adjacent": { "type": "boolean", "description": "True if the depiction could be read as defamatory or false-light; routes straight to Risk Counsel" },
    "public_figure":       { "type": "boolean" },
    "conflicting_sources": { "type": "boolean" },
    "unresolved_questions":{ "type": "array", "items": { "type": "string" } },
    "confidence":          { "type": "number" }
  },
  "required": ["person_name", "living", "confidence"]
}
