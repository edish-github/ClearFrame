{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "work_title":          { "type": "string" },
    "creator":             { "type": "string", "description": "Photographer, artist, cinematographer, or originating production" },
    "creator_living":      { "type": "string", "description": "living | deceased | unknown — a living artist's work is never de minimis" },
    "current_rights_holder": { "type": "string" },
    "archive_or_agency":   { "type": "string", "description": "Stock agency, archive, or collection holding the item" },
    "creation_year":       { "type": "integer" },
    "publication_year":    { "type": "integer" },
    "copyright_status":    { "type": "string", "description": "in_copyright | public_domain | orphan | unknown" },
    "public_domain_basis": { "type": "string", "description": "If public_domain, the specific basis and jurisdiction" },
    "license_lineage":     {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": { "holder": {"type":"string"}, "year": {"type":"integer"}, "license_type": {"type":"string"}, "source_url": {"type":"string"} },
        "required": ["holder", "source_url"]
      }
    },
    "orphan_work_signals": { "type": "array", "items": { "type": "string" }, "description": "Evidence the rights holder cannot be identified or located" },
    "provenance_disputes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": { "summary": {"type":"string"}, "status": {"type":"string"}, "source_url": {"type":"string"} },
        "required": ["summary", "source_url"]
      }
    },
    "litigation_signals":  {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": { "summary": {"type":"string"}, "status": {"type":"string"}, "source_url": {"type":"string"} },
        "required": ["summary", "source_url"]
      }
    },
    "conflicting_sources": { "type": "boolean" },
    "unresolved_questions":{ "type": "array", "items": { "type": "string" } },
    "confidence":          { "type": "number" }
  },
  "required": ["current_rights_holder", "copyright_status", "confidence"]
}
