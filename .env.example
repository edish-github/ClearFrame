# ClearFrame environment. Copy to .env and fill in. Never commit .env.
# Secrets live in Secret Manager in the cloud; the values here are for local runs.

# ---------------------------------------------------------------- Google Cloud
PROJECT_ID=clearframe-prod
REGION=us-central1

# `local` runs the whole system on disk — research still hits the live Parallel
# API. `gcp` uses Firestore, Pub/Sub, BigQuery, GCS.
CLEARFRAME_BACKEND=local
CLEARFRAME_LOCAL_ROOT=.local
# The local spine. `file` crosses process boundaries, which is what `make dev`
# needs; `inproc` is faster for a single-process run (tests, scripts/run_local_pass).
CLEARFRAME_BUS=file
# Names this process on the local spine. deploy.sh and the Makefile set it per service.
CLEARFRAME_SERVICE=orchestrator

# ------------------------------------------------------------- Vertex / Gemini
VERTEX_PROJECT=
VERTEX_LOCATION=us-central1
MODEL_PRO=gemini-2.5-pro
MODEL_FLASH=gemini-2.5-flash

# ---------------------------------------- Gemini Enterprise Agent Builder (opt)
# Set AGENT_APP_ID to drive hosted playbooks instead of the local runner.
AGENT_APP_ID=
DATASTORE_EO_ID=
DATASTORE_HANDBOOKS_ID=

# -------------------------------------------------------------------- Pub/Sub
TOPIC_RESEARCH=cf-research
TOPIC_FINDINGS=cf-findings
TOPIC_DECISIONS=cf-decisions
TOPIC_MONITOR=cf-monitor

# -------------------------------------------------------------- Storage / data
BUCKET_CUTS=cf-cuts
BUCKET_REPORTS=cf-reports
BUCKET_SNAPSHOTS=cf-snapshots
BQ_DATASET=clearframe

# ------------------------------------------------ Service URLs (deploy.sh fills)
URL_ADAPTER=
URL_LEDGER=
URL_WEBHOOK=
URL_RENDERER=
URL_ORCHESTRATOR=

# -------------------------------------------------------------------- Parallel
PARALLEL_BASE=https://api.parallel.ai
PARALLEL_MCP_URL=https://mcp.parallel.ai/v1beta/search_mcp
# Local development only. In `gcp` mode these come from Secret Manager as
# `parallel-api-key` and `parallel-webhook-secret`, and no agent can read them.
PARALLEL_API_KEY=
PARALLEL_WEBHOOK_SECRET=

# -------------------------------------------------------------------- Identity
# Identity is proved, never asserted. Blank values are safe defaults: the service
# simply refuses callers it cannot verify.
IAP_AUDIENCE=
PUSH_AUDIENCE=
PUBSUB_PUSH_SA=
TRUSTED_PROXY_SA=
# Public demo: let a visitor choose which role they act as, so a judge can walk the
# counsel gate without four accounts. It grants nothing — authority still comes
# from that subject's role binding. Never enable on a project with real material.
DEMO_IDENTITY=false

# ---------------------------------------------------------------------- Policy
DEFAULT_BUDGET_CAP_USD=60
MAX_CHALLENGES=2
MONITOR_FREQUENCY=1d
