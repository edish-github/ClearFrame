# -----------------------------------------------------------------------------
# ClearFrame Environment Configuration
# -----------------------------------------------------------------------------

# Server & Auth
PORT=8080
PUBLIC_URL=http://localhost:8080
CORS_ORIGIN=*
JWT_SECRET=dev-only-secret-change-me-0000000000
INTERNAL_SWEEP_SECRET=

# Database (PostgreSQL 16)
DATABASE_URL=postgres://clearframe:clearframe@localhost:5432/clearframe

# Storage (local or gcs)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./.data
# GCS_BUCKET=your-gcs-bucket-name

# Reasoning Layer (Google Cloud Vertex AI via @google/genai)
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
# Vertex uses Application Default Credentials, not an API key.
# Locally: gcloud auth application-default login
GEMINI_MODEL_PRO=gemini-2.5-pro
GEMINI_MODEL_FLASH=gemini-2.5-flash
GEMINI_PRO_INPUT_PER_MTOK=1.25
GEMINI_PRO_OUTPUT_PER_MTOK=10.0
GEMINI_FLASH_INPUT_PER_MTOK=0.3
GEMINI_FLASH_OUTPUT_PER_MTOK=2.5

# Retrieval Layer (Parallel)
PARALLEL_API_KEY=
PARALLEL_BASE_URL=https://api.parallel.ai
PARALLEL_SEARCH_USD=0.005
PARALLEL_TASK_CORE_USD=0.05
PARALLEL_TASK_PRO_USD=0.30
PARALLEL_MONITORS_ENABLED=false
# PARALLEL_WEBHOOK_SECRET=

# Worker Settings
WORKER_CONCURRENCY=4
WORKER_POLL_MS=1000
MONITOR_INTERVAL_HOURS=24

# Frontend (Vite)
VITE_API_URL=http://localhost:8080
